#version 450

#include "types.glsl"
#include "generic_unary_head.glsl"
#include "kv_chunk.glsl"

// the source and destination elements (chunked K/V: through the chunk table, kv_chunk.glsl)
#if defined(KVC_SRC_BINDING)
#define KVC_SRC(I) KVC_SRC_AT(I)
#else
#define KVC_SRC(I) data_a[I]
#endif
#if defined(KVC_DST_BINDING)
#define KVC_DST(I) KVC_DST_AT(I)
#else
#define KVC_DST(I) data_d[I]
#endif

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint idx = get_idx();

    if (idx >= p.ne) {
        return;
    }

#if defined(DATA_A_BF16)
    KVC_DST(get_doffset() + dst_idx(idx)) = D_TYPE(bf16_to_fp32(uint32_t(KVC_SRC(get_aoffset() + src0_idx(idx)))));
#elif defined(DATA_D_BF16)
    float f = float(KVC_SRC(get_aoffset() + src0_idx(idx)));
    KVC_DST(get_doffset() + dst_idx(idx)) = D_TYPE(fp32_to_bf16(f));
#elif !defined(OPTIMIZATION_ERROR_WORKAROUND)
    KVC_DST(get_doffset() + dst_idx(idx)) = D_TYPE(KVC_SRC(get_aoffset() + src0_idx(idx)));
#else
    KVC_DST(get_doffset() + dst_idx(idx)) = KVC_SRC(get_aoffset() + src0_idx(idx));
#endif
}
