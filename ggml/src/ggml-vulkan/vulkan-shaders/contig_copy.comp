#version 450

#include "types.glsl"
#include "generic_unary_head.glsl"
#include "kv_chunk.glsl"

// the source and destination elements (chunked K/V: through the chunk table, kv_chunk.glsl)
#if defined(KVC_SRC_BINDING)
#define KVC_SRC(I) KVC_SRC_AT(I)
#else
#define KVC_SRC(I) data_a[I]
#endif
#if defined(KVC_DST_BINDING)
#define KVC_DST(I) KVC_DST_AT(I)
#else
#define KVC_DST(I) data_d[I]
#endif

#extension GL_EXT_control_flow_attributes : require

const uint num_threads = 128;

layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = get_idx();

    // num_threads * num_iter must equal 512, to match the wg_denoms and get_idx calculation
    const uint num_iter = 4;

    // fast path for when all four iterations are in-bounds
    if (idx + (num_iter-1)*num_threads < p.ne) {
        [[unroll]] for (uint i = 0; i < num_iter; ++i) {

#if defined(DATA_A_BF16)
            KVC_DST(get_doffset() + idx) = D_TYPE(bf16_to_fp32(uint32_t(KVC_SRC(get_aoffset() + idx))));
#elif defined(DATA_D_BF16)
            float f = float(KVC_SRC(get_aoffset() + idx));
            KVC_DST(get_doffset() + idx) = D_TYPE(fp32_to_bf16(f));
#elif !defined(OPTIMIZATION_ERROR_WORKAROUND)
            KVC_DST(get_doffset() + idx) = D_TYPE(KVC_SRC(get_aoffset() + idx));
#else
            KVC_DST(get_doffset() + idx) = KVC_SRC(get_aoffset() + idx);
#endif
            idx += num_threads;
        }
    } else {
        [[unroll]] for (uint i = 0; i < num_iter; ++i) {
            if (idx >= p.ne) {
                continue;
            }

#if defined(DATA_A_BF16)
            KVC_DST(get_doffset() + idx) = D_TYPE(bf16_to_fp32(uint32_t(KVC_SRC(get_aoffset() + idx))));
#elif defined(DATA_D_BF16)
            float f = float(KVC_SRC(get_aoffset() + idx));
            KVC_DST(get_doffset() + idx) = D_TYPE(fp32_to_bf16(f));
#elif !defined(OPTIMIZATION_ERROR_WORKAROUND)
            KVC_DST(get_doffset() + idx) = D_TYPE(KVC_SRC(get_aoffset() + idx));
#else
            KVC_DST(get_doffset() + idx) = KVC_SRC(get_aoffset() + idx);
#endif
            idx += num_threads;
        }
    }
}
